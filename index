  const addr=get(schema.addr)||[get(['기본배송지','수령인 기본주소']),get(['상세배송지','수령인 상세주소'])].filter(Boolean).join(' ');
  const detail=get(['수령인 상세주소']);const address=schema.name==='카페24'&&detail&&!addr.includes(detail)?[addr,detail].filter(Boolean).join(' '):addr;
  const postcode=get(['받는분우편번호','수령인 우편번호','우편번호']);
  const review=schema.name==='사그담'?'기존 출고 확인':schema.name==='스마트스토어'&&!get(['발주확인일'])?'발주확인 여부 확인':'';
  return [{channel:schema.name,id,recipient:get(schema.recipient),phone:get(schema.phone),phone2:get(schema.phone2),address,postcode:/^\d{1,4}$/.test(postcode)?postcode.padStart(5,'0'):postcode,product:get(schema.product),option:get(schema.option),qty:get(schema.qty),memo:get(['배송메세지','배송메시지','배송 메모']),review}];
 })};
}
function matches(row,s){const head=row.map(norm);return s.detect.every(k=>head.includes(norm(k)))&&s.recipient.some(k=>head.includes(norm(k)))}
const types=[['극소','1',3500],['소','2',3600],['중','3',4400],['대1','4',5450],['대2','7',6000],['이형','',12900],['취급제한','',16850]];
const money=x=>x.toLocaleString('ko-KR')+'원';
let orders=[], groups=[], selectedFiles=[], busy=false;
const missing=o=>!o.recipient||!o.phone||!o.address||!o.product;
const item=o=>[o.product,o.option].filter(Boolean).join(' / ')+(o.qty?' × '+o.qty:'');
function groupRows(){
 const map=new Map();
 for(const o of orders){
  const key=by('merge').checked&&!missing(o)?JSON.stringify([norm(o.recipient),o.phone.replace(/\D/g,''),norm(o.address),o.postcode]):o.key;
  if(!map.has(key))map.set(key,[]);map.get(key).push(o);
 }groups=[...map.values()].map(newGroup);
 render();
}
function newGroup(rows){
 return {rows,count:1,type:types[0],code:types[0][1],included:!rows.some(missing)};
}
function el(tag,text,parent){const e=document.createElement(tag);if(text)e.textContent=text;parent?.append(e);return e}
function sync(){
 const checked=groups.filter(g=>g.included);
 const eligible=groups.filter(g=>!g.rows.some(missing));
 const all=by('select-all');
 all.disabled=busy||!eligible.length;
 all.checked=eligible.length>0&&eligible.every(g=>g.included);
 all.indeterminate=!all.checked&&eligible.some(g=>g.included);
 by('summary').textContent=orders.length+'주문 · '+groups.length+'묶음 · '+checked.length+'선택';
 by('download').disabled=busy||!checked.length||checked.some(g=>!g.type||!g.code||!Number.isInteger(g.count)||g.count<1||g.count>999||g.rows.some(missing));
}
function render(){
 const body=by('body');body.replaceChildren();
 for(const g of groups){
  const r=el('tr','',body), first=g.rows[0], box=el('input','',el('td','',r));box.type='checkbox';box.checked=g.included;box.disabled=g.rows.some(missing);
  box.setAttribute('aria-label',first.recipient+' 내보내기');box.onchange=()=>{g.included=box.checked;sync()};
  const addr=el('td','',r);el('strong',first.recipient||'수취인 누락',addr);el('small',first.address||'주소 누락',addr);el('small',first.phone||'연락처 누락',addr);
  const info=el('td','',r);
  if(g.rows.length>1){const split=el('button','이 묶음 분리',info);split.onclick=()=>{groups.splice(groups.indexOf(g),1,...g.rows.map(row=>newGroup([row])));render()}}
  for(const o of g.rows){el('div',o.channel+' · '+item(o),info);el('small',[o.id,o.review,o.memo].filter(Boolean).join(' · '),info)}
  const count=el('input','',el('td','',r));count.type='number';count.min=1;count.max=999;count.value=g.count;count.setAttribute('aria-label','박스수량');
  const cell=el('td','',r), select=el('select','',cell);select.setAttribute('aria-label','박스타입');el('option','선택',select).value='';
  for(const [i,t] of types.entries())el('option',t[0]+' '+money(t[2]),select).value=i;
  if(g.type)select.value=types.indexOf(g.type);
  const code=el('input','',cell);code.placeholder='CJ 코드';code.setAttribute('aria-label','CJ 박스코드');code.maxLength=4;code.value=g.code;code.hidden=!g.type||!!g.type[1];
  const total=el('td','',r);
  function update(){total.textContent=g.type&&g.count>0?money(g.type[2]*g.count):'—';sync()}
  count.oninput=()=>{g.count=count.valueAsNumber;update()};select.onchange=()=>{g.type=select.value===''?null:types[select.value];g.code=g.type?.[1]||'';code.value=g.code;code.hidden=!g.type||!!g.type[1];update()};code.oninput=()=>{g.code=str(code.value);sync()};update();
 }
 sync();
}
async function load(files){
 busy=true;orders=[];groups=[];render();by('reload').disabled=true;
 const lines=[], unique=new Map(), conflicts=new Set();let dup=0;
 const candidates=files.filter(f=>/\.xlsx?$/i.test(f.name)&&!/^~\$|^CJ_/i.test(f.name));
 for(const f of candidates){
  by('log').textContent='읽는 중 · '+f.name;
  try{
   const results=(await sheets(new Uint8Array(await f.arrayBuffer()),by('pw').value)).map(extract).filter(Boolean);
   if(!results.length){lines.push(f.name+' · 해당 주문 양식을 찾지 못함');continue}
   const rows=results.flatMap(x=>x.rows);
   lines.push(f.name+' · '+rows.length+'행');
   for(const o of rows){
    const key=JSON.stringify([o.channel,o.id,o.product,o.option,o.qty]);
    if(unique.has(key)){dup++;if(JSON.stringify(unique.get(key))!==JSON.stringify(o))conflicts.add(key);continue}
    unique.set(key,o);
   }
  }catch(e){lines.push(f.name+' · '+e.message)}
 }
 orders=[...unique].filter(([key])=>!conflicts.has(key)).map(([key,o])=>({...o,key}));
 if(dup)lines.push('중복 주문행 '+dup+'건 제외');if(conflicts.size)lines.push('내용이 다른 중복 '+conflicts.size+'건은 원본 확인 필요');
 by('log').textContent=lines.join('\n')||'읽을 수 있는 주문 엑셀 파일이 없습니다.';
 busy=false;by('reload').disabled=false;groupRows();
}
let handle=null;
async function readFolder(h){
 const found=[];for await(const entry of h.values())if(entry.kind==='file')found.push(await entry.getFile());
 selectedFiles=found;await load(found);
}
by('pick').onclick=async()=>{
 if(window.showDirectoryPicker){
  try{handle=await window.showDirectoryPicker({id:'shipping-orders',mode:'read'});by('dest').textContent=handle.name;await readFolder(handle);return}catch(e){if(e.name==='AbortError')return}
 }
 by('files').click();
};
by('files').onchange=e=>{handle=null;selectedFiles=[...e.target.files];if(!selectedFiles.length)return;by('dest').textContent=selectedFiles[0].webkitRelativePath.split('/')[0];load(selectedFiles);e.target.value=''};
by('reload').onclick=()=>handle?readFolder(handle):by('files').click();
by('merge').onchange=groupRows;
by('select-all').onchange=event=>{
 for(const g of groups)g.included=event.target.checked&&!g.rows.some(missing);
 render();
};
async function output(groups, includeHeader){
 const parts=await unzip(b64(template)), key='xl/worksheets/sheet1.xml', doc=xml(parts.get(key)), ns=doc.documentElement.namespaceURI, data=tags(doc,'sheetData')[0];
 if(!includeHeader)data.removeChild(tags(data,'row')[0]);
 const firstRow=includeHeader?2:1;
 const trace=[];
 for(const [i,g] of groups.entries()){
  const f=g.rows[0], n=i+firstRow, shipment=g.rows.length===1?f.id:'CJ-'+Date.now()+'-'+(i+1);
  const memo=[...new Set(g.rows.map(o=>o.memo).filter(Boolean))];
  const fields={C:f.recipient,D:f.phone,E:f.phone2,F:f.postcode,G:f.address,I:shipment,J:g.rows.map(item).join(' / '),K:g.count,L:g.code,M:g.type[2]*g.count,N:memo.join(' / ')};
  const row=doc.createElementNS(ns,'row');row.setAttribute('r',n);
  for(const [col,value] of Object.entries(fields)){if(value==='')continue;
   const c=doc.createElementNS(ns,'c');c.setAttribute('r',col+n);
   if(col==='K'||col==='M'){const v=doc.createElementNS(ns,'v');v.textContent=value;c.append(v)}
   else{c.setAttribute('t','inlineStr');const a=doc.createElementNS(ns,'is'),t=doc.createElementNS(ns,'t');t.textContent=value;a.append(t);c.append(a)}
   row.append(c);
  }data.append(row);
  for(const o of g.rows)trace.push([shipment,o.channel,o.id]);
 }
 tags(doc,'dimension')[0].setAttribute('ref','A1:Q'+(groups.length+firstRow-1));
 parts.set(key,enc.encode(new XMLSerializer().serializeToString(doc)));
 return {blob:pack(parts),trace};
}
function save(blob,name){const a=document.createElement('a'),url=URL.createObjectURL(blob);a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),10000)}
by('download').onclick=async()=>{
 const list=groups.filter(g=>g.included);if(by('download').disabled)return;
 busy=true;sync();
 try{
  const {blob,trace}=await output(list,by('include-header').checked), stamp=new Date().toISOString().replace(/\D/g,'').slice(0,14), name='CJ_'+stamp+'.xlsx';
  save(blob,name);
  const csv=[['CJ 고객주문번호','판매채널','원본 주문번호'],...trace].map(row=>row.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(',')).join('\r\n');
  const line=el('p',name+' 다운로드 요청 완료 · '+list.length+'묶음 ',by('log'));const link=el('button','주문번호 매핑 CSV 저장',line);
  link.onclick=()=>save(new Blob(['\ufeff',csv],{type:'text/csv;charset=utf-8'}),'CJ_'+stamp+'_mapping.csv');
 }catch(e){by('log').textContent='엑셀 생성 실패 · '+e.message}finally{busy=false;sync()}
};
const packingTab=by('packing-tab'), trackingTab=by('tracking-tab');
function showTracking(active){
 by('packing-panel').hidden=active;
 by('tracking-panel').hidden=!active;
 packingTab.setAttribute('aria-pressed',String(!active));
 trackingTab.setAttribute('aria-pressed',String(active));
 packingTab.classList.toggle('primary',!active);
 trackingTab.classList.toggle('primary',active);
}
packingTab.onclick=()=>showTracking(false);
trackingTab.onclick=()=>showTracking(true);

function trackingRows(workbook){
 const result=[];
 let recognized=false;
 for(const sheet of workbook){
  const headers=sheet.map(row=>row.map(norm));
  const nameLabels=['받는분명','받는분성명','수취인명','수취인이름'];
  const numberLabels=['운송장번호','송장번호'];
  const index=headers.findIndex(row=>row.some(v=>nameLabels.includes(v))&&row.some(v=>numberLabels.includes(v)));
  if(index<0)continue;
  recognized=true;
  const name=headers[index].findIndex(v=>nameLabels.includes(v));
  const number=headers[index].findIndex(v=>numberLabels.includes(v));
  for(const row of sheet.slice(index+1)){
   const recipient=str(row[name]), tracking=str(row[number]);
   if((recipient||tracking)&&!nameLabels.includes(norm(recipient))&&!numberLabels.includes(norm(tracking)))result.push({recipient,tracking});
  }
 }
 if(!recognized)throw Error('받는분명과 운송장번호 열을 찾지 못했습니다.');
 return result;
}
let trackingResults=[];
const trackingInput=by('tracking-file'), trackingQuery=by('tracking-query'), trackingStatus=by('tracking-status'), trackingBody=by('tracking-body');
function renderTracking(){
 const query=norm(trackingQuery.value).toLowerCase();
 const matches=trackingResults.filter(row=>norm(row.recipient).toLowerCase().includes(query)||norm(row.tracking).replace(/-/g,'').toLowerCase().includes(query.replace(/-/g,'')));
 trackingBody.replaceChildren();
 for(const row of matches){
  const tr=el('tr','',trackingBody);
  el('td',row.recipient||'수취인명 없음',tr);
  el('td',row.tracking||'운송장번호 없음',tr);
 }
 const missingNumbers=trackingResults.filter(row=>!row.tracking).length;
 trackingStatus.textContent='총 '+trackingResults.length+'행 · 표시 '+matches.length+'행'+(missingNumbers?' · 번호 없음 '+missingNumbers+'행':'');
}
trackingQuery.oninput=renderTracking;
trackingInput.onchange=async()=>{
 const file=trackingInput.files[0];
 if(!file)return;
 trackingInput.disabled=true;
 trackingQuery.disabled=true;
 trackingQuery.value='';
 trackingResults=[];
 trackingBody.replaceChildren();
 trackingStatus.textContent='파일 읽는 중 · '+file.name;
 try{
  trackingResults=trackingRows(await sheets(new Uint8Array(await file.arrayBuffer()),''));
  trackingQuery.disabled=!trackingResults.length;
  renderTracking();
 }catch(error){trackingStatus.textContent=error.message}
 finally{trackingInput.disabled=false;trackingInput.value=''}
};

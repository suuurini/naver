  // AES-CBC 복호화(패딩 없음). WebCrypto는 PKCS7만 지원하므로 패딩 블록을 하나 덧붙여 우회한다.
  async function aesCbcDec(ck, iv, data) {
    const last = data.subarray(data.length - 16);
    const padBlock = new Uint8Array(await crypto.subtle.encrypt({ name: 'AES-CBC', iv: last }, ck, new Uint8Array(0))).subarray(0, 16);
    return new Uint8Array(await crypto.subtle.decrypt({ name: 'AES-CBC', iv }, ck, concat(data, padBlock)));
  }

  async function decryptAgile(info, password, onProgress) {
    const xml = new TextDecoder().decode(info.subarray(8)).replace(/^﻿/, '');
    const doc = new DOMParser().parseFromString(xml, 'application/xml');
    const kd = doc.getElementsByTagNameNS('*', 'keyData')[0];
    const ek = doc.getElementsByTagNameNS('*', 'encryptedKey')[0];
    if (!kd || !ek) throw new UserError('지원하지 않는 암호화 방식입니다.');
    const A = (el, n) => el.getAttribute(n);
    const alg = HASH[A(ek, 'hashAlgorithm')];
    if (!alg || A(ek, 'cipherAlgorithm') !== 'AES') throw new UserError('지원하지 않는 암호화 방식입니다.');
    const salt = b64(A(ek, 'saltValue'));
    const spin = +A(ek, 'spinCount');
    const keyLen = +A(ek, 'keyBits') / 8;
    const saltSize = +A(ek, 'saltSize');

    let h = await digest(alg, concat(salt, utf16le(password)));
    for (let i = 0; i < spin; i++) {
      h = await digest(alg, concat(u32le(i), h));
      if (i % 20000 === 0) { onProgress && onProgress(i / spin); await tick(); }
    }
    const derive = async (blockKey) => {
      let k = await digest(alg, concat(h, blockKey));
      if (k.length < keyLen) k = concat(k, new Uint8Array(keyLen - k.length).fill(0x36));
      return crypto.subtle.importKey('raw', k.subarray(0, keyLen), 'AES-CBC', false, ['encrypt', 'decrypt']);
    };
    const hex = (s) => Uint8Array.from(s.match(/../g).map((x) => parseInt(x, 16)));
    const kIn = await derive(hex('fea7d2763b4b9e79'));
    const kVal = await derive(hex('d7aa0f6d3061344e'));
    const kKey = await derive(hex('146e0be7abacd0d6'));
    const vIn = await aesCbcDec(kIn, salt, b64(A(ek, 'encryptedVerifierHashInput')));
    const vVal = await aesCbcDec(kVal, salt, b64(A(ek, 'encryptedVerifierHashValue')));
    const check = await digest(alg, vIn.subarray(0, saltSize));
    if (!eq(check, vVal.subarray(0, check.length))) throw new UserError('비밀번호가 맞지 않습니다. 다시 확인해 주세요.');
    const secret = (await aesCbcDec(kKey, salt, b64(A(ek, 'encryptedKeyValue')))).subarray(0, keyLen);
    return { secret, kdSalt: b64(A(kd, 'saltValue')), kdAlg: HASH[A(kd, 'hashAlgorithm')], blockSize: +A(kd, 'blockSize') };
  }

  async function decryptPackage(cfb, password, onProgress) {
    const info = cfb.stream('EncryptionInfo');
    const pkg = cfb.stream('EncryptedPackage');
    if (!info || !pkg) throw new UserError('엑셀 파일 형식이 아닙니다.');
    const major = info[0] | (info[1] << 8), minor = info[2] | (info[3] << 8);
    if (!(major === 4 && minor === 4)) throw new UserError('지원하지 않는 암호화 방식입니다. (Excel 2010 이상에서 저장한 파일만 가능)');
    const { secret, kdSalt, kdAlg, blockSize } = await decryptAgile(info, password, onProgress);
    const pdv = new DataView(pkg.buffer, pkg.byteOffset, pkg.byteLength);
    const size = pdv.getUint32(0, true) + pdv.getUint32(4, true) * 4294967296;
    const data = pkg.subarray(8);
    const ck = await crypto.subtle.importKey('raw', secret, 'AES-CBC', false, ['encrypt', 'decrypt']);
    const out = [];
    for (let i = 0, off = 0; off < data.length; i++, off += 4096) {
      const seg = data.subarray(off, Math.min(off + 4096, data.length));
      const iv = (await digest(kdAlg, concat(kdSalt, u32le(i)))).subarray(0, blockSize);
      out.push(await aesCbcDec(ck, iv, seg));
    }
    return concat(...out).subarray(0, size);
  }


